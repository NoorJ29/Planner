rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Your own data: only you can read or change it.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared family lists: only members can see or change them.
    match /shared/{listId} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }
      // Joining with a valid invite code: you may only add yourself.
      function isJoining() {
        return request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo', 'joinCode'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.listId == listId;
      }
      allow read: if isMember();
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if isMember() || isJoining();
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;

      match /items/{itemId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/shared/$(listId)).data.members;
      }
    }

    // Invite codes: anyone signed in can look up a code they were given.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/shared/$(request.resource.data.listId)).data.members;
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }
  }
}
