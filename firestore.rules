rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Your own data: only you can read or change it.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Invite codes last 7 days (in milliseconds).
    function inviteFresh(inv) {
      return request.time.toMillis() - inv.createdAt < 604800000;
    }

    // Shared family lists: only members can see them. Only the owner can rename or delete.
    match /shared/{listId} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }
      function isOwner() {
        return request.auth != null && request.auth.uid == resource.data.owner;
      }
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function onlyMyInfoChanged() {
        return request.resource.data.get('memberInfo', {}).diff(resource.data.get('memberInfo', {})).affectedKeys().hasOnly([request.auth.uid]);
      }
      // The owner can change anything except who owns it, and can't remove themselves.
      function isOwnerEdit() {
        return isOwner()
          && request.resource.data.owner == resource.data.owner
          && request.auth.uid in request.resource.data.members;
      }
      // Other members can only take themselves off the list.
      function isLeaving() {
        return isMember() && !isOwner()
          && changed().hasOnly(['members', 'memberInfo'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())
          && onlyMyInfoChanged();
      }
      // Joining with a valid, unexpired invite code: you may only add yourself.
      function isJoining() {
        let inv = get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data;
        return request.auth != null && !(request.auth.uid in resource.data.members)
          && changed().hasOnly(['members', 'memberInfo', 'joinCode'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && onlyMyInfoChanged()
          && inv.listId == listId
          && inviteFresh(inv);
      }
      allow read: if isMember();
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if isOwnerEdit() || isLeaving() || isJoining();
      allow delete: if isOwner();

      match /items/{itemId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/shared/$(listId)).data.members;
      }
    }

    // Invite codes: anyone signed in can look up a code they were given, for 7 days.
    match /invites/{code} {
      allow get: if request.auth != null && inviteFresh(resource.data);
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/shared/$(request.resource.data.listId)).data.members
        && request.resource.data.createdAt is int
        && math.abs(request.resource.data.createdAt - request.time.toMillis()) < 3600000;
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }
  }
}
